# ============================================================================
# KONFIGURASI ENVIRONMENT VARIABLES — AUTH & DANA BISNIS QRIS INTEGRATION
# ============================================================================

# Port Server Aplikasi (Default AI Studio: 3000)
PORT=3000

# Secret Key untuk penandatanganan JSON Web Token (JWT) Autentikasi
JWT_SECRET=your_super_secret_jwt_signing_key_min_32_chars

# ============================================================================
# KREDENSIAL API DANA BISNIS (SNAP BI / QRIS DYNAMIC ORDER)
# Dapatkan dari Dashboard DANA Bisnis / DANA Developer Portal:
# https://dashboard.dana.id atau https://developer.dana.id
# ============================================================================

# Mode Environment DANA: 'sandbox' untuk pengujian, 'production' untuk live
DANA_ENV=sandbox

# Base URL Endpoint API DANA Bisnis
# Sandbox    : https://api.sandbox.dana.id
# Production : https://api.dana.id
DANA_BASE_URL=https://api.sandbox.dana.id

# Merchant ID & Partner/Client ID dari DANA Bisnis
DANA_MERCHANT_ID=21662000010928371
DANA_CLIENT_ID=202603019928371625

# Client Secret untuk generate X-SIGNATURE pada request pembuatan QRIS
DANA_CLIENT_SECRET=your_dana_bisnis_client_secret_key

# Webhook Secret untuk validasi X-SIGNATURE pada callback/notifikasi pembayaran DANA
DANA_WEBHOOK_SECRET=your_dana_bisnis_webhook_signature_secret

# URL Publik aplikasi untuk menerima HTTP POST Webhook dari server DANA
DANA_WEBHOOK_URL=http://localhost:3000/api/payment/qris/webhook
