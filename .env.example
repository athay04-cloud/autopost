# ============================================================================
# KONFIGURASI ENVIRONMENT VARIABLES — PAYPAL LIVE API INTEGRATION
# Situs Produksi: https://athay04-cloud.github.io/autopost/
# ============================================================================

# Port Server Aplikasi (Default AI Studio: 3000)
PORT=3000

# Secret Key untuk penandatanganan JSON Web Token (JWT) Autentikasi
JWT_SECRET=your_super_secret_jwt_signing_key_min_32_chars

# ============================================================================
# KREDENSIAL PAYPAL LIVE (HANYA BUTUH 2 DATA DARI PANEL "KREDENSIAL API" PAYPAL)
# Penting: Klik ikon Copy (Salin) di sebelah kanan pada dashboard PayPal Anda
# karena tampilan teks di layar PayPal terpotong di bagian ujung kanan.
# ============================================================================

# Mode Environment PayPal: 'live' (aktif sesuai screenshot Anda) atau 'sandbox'
PAYPAL_MODE=live

# 1. KUNCI API (PayPal Client ID — diawali BAAEaww49ypRDZfMIBESd0o_OEeDRIZzpNdDLeV0cC3...)
# Digunakan oleh PayPal JS SDK di https://athay04-cloud.github.io/autopost/ & Server
VITE_PAYPAL_CLIENT_ID=paste_full_kunci_api_paypal_live_disini
PAYPAL_CLIENT_ID=paste_full_kunci_api_paypal_live_disini

# 2. KODE RAHASIA (PayPal Secret Key — diawali EDZMXg6sHLcaGQqV9NoZBLOcvB0z2JEAi7ZHrY2XN9V...)
# Digunakan oleh backend REST API v2 (/v1/oauth2/token & /v2/checkout/orders)
PAYPAL_CLIENT_SECRET=paste_full_kode_rahasia_paypal_live_disini

# URL Situs Produksi Anda (GitHub Pages) untuk return_url & cancel_url PayPal
APP_BASE_URL=https://athay04-cloud.github.io/autopost

